# Personal settings live in .env (gitignored). Setup creates it from this
# file: run ./setup.sh (macOS/Linux) or setup.cmd (Windows), and re-run with
# "configure" to change answers. You can also edit .env by hand and then run
# setup again to apply.

# ---------------------------------------------------------------- Open WebUI

# Setup generates this. To make one yourself:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=

# Image tag. "main" tracks the newest build; pin a release tag for control.
OPEN_WEBUI_TAG=main

# Host interface to bind. Keep 127.0.0.1 and use Tailscale for remote access.
# Setting 0.0.0.0 exposes Open WebUI to your whole LAN over plain HTTP.
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=3000

# Docker volume holding accounts and chats. Set to an existing volume name
# to reuse data from a previous `docker run` install.
OPEN_WEBUI_VOLUME=open-webui

# false: .env is the source of truth and is re-applied on every start.
# true: Open WebUI keeps Admin Panel changes and ignores later .env edits.
ENABLE_PERSISTENT_CONFIG=false

# Multi-user privacy. Keep false so the admin can't read or export
# other family members' chats through Open WebUI.
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false

# Only the first account (the admin) can sign up; the admin adds the rest.
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
ENABLE_COMMUNITY_SHARING=false

# -------------------------------------------------------------------- Ollama

# native: Ollama app on the host (required on macOS for the GPU; default on
#         Windows). container: Ollama in Docker (default on Linux).
OLLAMA_MODE=native

# Where Open WebUI finds Ollama, from inside its container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://ollama:11434

# Container mode only: ollama-cpu, ollama-nvidia or ollama-amd.
COMPOSE_PROFILES=
# COMPOSE_PROFILES=ollama-cpu
# COMPOSE_PROFILES=ollama-nvidia
# COMPOSE_PROFILES=ollama-amd
OLLAMA_TAG=latest
OLLAMA_VOLUME=ollama

# Models setup downloads, space-separated. Catalog: models.txt
# The tag picks the quantization, e.g. qwen3:14b-q8_0 (see each model's
# Tags page on ollama.com). Most default tags are 4-bit (q4_K_M).
OLLAMA_PULL_MODELS=
# Model new chats start with; setup sets it to the first model above.
DEFAULT_MODELS=
# Background tasks. Titles use the chat model unless TASK_MODEL names another
# (a second model must fit in GPU memory next to the chat model, or Ollama
# unloads one to run the other). Tags and follow-up suggestions are off
# because each is another full model call on the same GPU.
TASK_MODEL=
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false

# Folder for downloaded models, e.g. D:\Ollama Models or /Volumes/Big/ollama.
# Empty = Ollama's default (native: ~/.ollama/models; container: inside the
# Docker volume above). `setup configure` searches for folders that already
# hold models, so they aren't downloaded again. Native mode: copied to the
# Ollama app's environment, like the GPU memory settings below.
OLLAMA_MODELS=

# GPU memory tuning. Empty = Ollama's default. Context (the conversation
# Ollama keeps in memory) needs GPU memory on top of the model itself.
# Native mode: setup copies these to the Ollama app's environment (Windows
# user environment variables; launchctl on macOS) and restarts Ollama when
# they change. An empty value removes the variable there.
# Max tokens of context, e.g. 8192 or 16384. Lower uses less GPU memory.
OLLAMA_CONTEXT_LENGTH=
# 1: flash attention on (less memory, usually faster; required by the next
# one). 0: off.
OLLAMA_FLASH_ATTENTION=
# Context cache precision: f16 (default), q8_0 (about half the memory, little
# quality loss) or q4_0 (about a quarter, noticeable loss).
OLLAMA_KV_CACHE_TYPE=
# How long a model stays in GPU memory after its last use, e.g. 5m (Ollama's
# default), 1h, or -1 for forever: the first reply after a pause starts at
# once, but the GPU memory stays in use for other apps too.
OLLAMA_KEEP_ALIVE=

# ----------------------------------------------------------- Remote access

# true: setup runs `tailscale serve`, giving https://<pc-name>.<tailnet>.ts.net
TAILSCALE_SERVE=true

# ------------------------------------------- Optional: cloud models (off)

# Chats sent to these models leave your machine. Semicolon-separated lists;
# the Nth key goes with the Nth URL.
ENABLE_OPENAI_API=false
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=
# OPENAI_API_BASE_URLS=https://api.openai.com/v1
# OPENAI_API_BASE_URLS=https://openrouter.ai/api/v1

# ------------------------------------------------- Web search (on, DuckDuckGo)

# On by default. In a chat, switch it on with the Web Search toggle, or have
# a model start every chat with it: Admin Panel > Settings > Models > (model)
# > Default Features > Web Search. Search queries, written from the chat by
# the model, go to the provider; the chat itself stays here. Engines:
# duckduckgo (no key), brave, tavily, serpapi, external (auto fallback,
# see below). false: no web access.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# SerpAPI (Google results).
SERPAPI_API_KEY=
# WEB_SEARCH_ENGINE=external (setup calls it "auto") falls back automatically:
# each search tries these in order and uses the first that answers, so a
# key that runs out of credits doesn't stop search. Engines without a key
# are skipped; duckduckgo needs none.
# SEARCH_ORDER=tavily serpapi duckduckgo# Search results are pasted into the model's context, so web search needs an
# OLLAMA_CONTEXT_LENGTH of at least 16384. With less, Ollama silently drops
# the start of the prompt (including the results) and the model answers from
# its outdated training data instead. Setup warns about this.
# Pages fetched per search. `setup configure` sets this and the next one from
# the context length: 4 whole pages at 65536+, else 5 excerpts.
WEB_SEARCH_RESULT_COUNT=5
# false: send the model only the parts of each page that best match the query.
# true: send whole pages. Usually better answers, but needs 32768+ context.
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=false
